// Nexa Terra: Standing Orders tuning and preset rule cards.
//
// Units: temperatures in centi-degrees C, power in percent of stored charge.
// A card fires once when all its triggers become true, then re-arms only after
// one of its triggers has moved back past its threshold by the margin below
// (see docs/architecture.md, "Standing Orders rule cards"). Priority 1 runs first.
(
    tuning: (
        // How many cards the Caretaker terminal holds.
        memory: 8,
        // 2.0 C: wider than the FREEZE/NOMINAL flutter of a starved hab.
        temp_margin_centi_c: 200,
        power_margin_percent: 5,
    ),
    // The terminal's card builder: priority 1 up to priority_max, and how far
    // one key press moves a threshold. Power steps by 1 below one full step.
    editor: (
        priority_max: 9,
        power_start_percent: 25,
        power_step_percent: 5,
        // 0.5 C per press, from -50.0 C to 100.0 C.
        temp_step_centi_c: 50,
        temp_min_centi_c: -5000,
        temp_max_centi_c: 10000,
    ),
    // Postures: what most players load instead of building cards. Each has a
    // display name, a summary in plain words, its cards, and optionally battery
    // guards by module (`guards: { "smelter_01": Some((pause_below_percent: 25,
    // resume_above_percent: 60)) }`; `None` clears one, modules left out keep theirs).
    presets: {
        // Ash Plain, crew away: give up the smelter before the battery runs flat,
        // run both heaters and swing all line heat between the habs. The smelter
        // freezes and goes offline; both habs stay nominal.
        "protect-habs": (
            name: "Protect the habs",
            summary: "Keeps both habs warm. When power runs low the smelter is shut down for good, so no more ore is made.",
            cards: [
                (
                    priority: 1,
                    triggers: [PowerBelowPercent(25)],
                    actions: [Deactivate("smelter_01"), Activate("heater_02"), DivertHeat(to: "hab_01")],
                ),
                (
                    priority: 2,
                    triggers: [TempAbove(module: "hab_01", centi_c: 1600)],
                    actions: [DivertHeat(to: "hab_02")],
                ),
                (
                    priority: 2,
                    triggers: [TempAbove(module: "hab_02", centi_c: 1600)],
                    actions: [DivertHeat(to: "hab_01")],
                ),
            ],
        ),
        // Balanced. Milestone 6 gives it a guarded smelter that keeps working;
        // until then it is the same three cards as Protect the habs.
        "caretaker": (
            name: "Balanced",
            summary: "Keeps both habs warm and the smelter working as long as the power allows.",
            cards: [
                (
                    priority: 1,
                    triggers: [PowerBelowPercent(25)],
                    actions: [Deactivate("smelter_01"), Activate("heater_02"), DivertHeat(to: "hab_01")],
                ),
                (
                    priority: 2,
                    triggers: [TempAbove(module: "hab_01", centi_c: 1600)],
                    actions: [DivertHeat(to: "hab_02")],
                ),
                (
                    priority: 2,
                    triggers: [TempAbove(module: "hab_02", centi_c: 1600)],
                    actions: [DivertHeat(to: "hab_01")],
                ),
            ],
        ),
        // The example card from the design doc on its own: saves hab_01, loses hab_02.
        "doc-example": (
            name: "Design doc example",
            summary: "One card: when power runs low, shut down the smelter and send all heat to hab 1. Hab 2 is left to freeze.",
            cards: [
                (
                    priority: 1,
                    triggers: [PowerBelowPercent(25)],
                    actions: [Deactivate("smelter_01"), DivertHeat(to: "hab_01")],
                ),
            ],
        ),
    },
)
